FROM node:20-alpine

WORKDIR /app

# Копируем файлы зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь код клиента
COPY . .

# Открываем порт (Vite по умолчанию использует 5173)
EXPOSE 5173

# Запускаем Vite с флагом --host, чтобы он был доступен снаружи контейнера
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]