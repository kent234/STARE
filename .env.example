# STARE — ключи внешних источников.
# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Незаполненный ключ = источник просто не регистрируется (скан не падает).

# --- Обязательные для P1-1 ---
# abuse.ch Auth-Key (бесплатно): https://auth.abuse.ch/
# Нужен для URLhaus и ThreatFox; Feodo Tracker работает без ключа.
ABUSECH_AUTH_KEY=

# Shodan (free): https://account.shodan.io/  → раздел "API Key"
SHODAN_API_KEY=

# GreyNoise Community: https://viz.greynoise.io/account/  → "API Key"
# Ключ опционален: без него Community API тоже отвечает (строже лимит).
GREYNOISE_API_KEY=

# AbuseIPDB (free 1000/day): https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# --- Обогащение (P0-2) ---
# IPinfo (free 50k/mo, токен опционален): https://ipinfo.io/account/token
IPINFO_TOKEN=

# AlienVault OTX (опционален): https://otx.alienvault.com/settings
# Без ключа OTX отвечает 429 и просто пропускается.
# OTX_API_KEY=

# --- People-OSINT ---
# Breach-поиск бесплатный, без ключей: XposedOrNot + Hudson Rock (встроены).
# EmailRep free tier (250/мес): https://emailrep.io/free
# EMAILREP_API_KEY=
# GitHub token (опционально, поднимает лимит 60→5000/час): https://github.com/settings/tokens
# GITHUB_TOKEN=
# Внешние CLI (опционально): если бинарника нет — источник пропускается.
# SHERLOCK_BIN=sherlock
# MAIGRET_BIN=maigret
# MAIGRET_MAX_SITES=1000
# BLACKBIRD_BIN=blackbird
# BLACKBIRD_DIR=/opt/blackbird
# HOLEHE_BIN=holehe
# GHUNT_BIN=ghunt
# PHONEINFOGA_BIN=phoneinfoga
# WMN_URL=https://raw.githubusercontent.com/WebBreacher/WhatsMyName/main/wmn-data.json
# WMN_MAX_SITES=200
# Демо без внешних инструментов: PEOPLE_FIXTURE=1
# PEOPLE_FIXTURE=

# --- Nuclei (опционально) ---
# Внешний бинарник nuclei; если не установлен — раздел уязвимостей будет пустым.
# NUCLEI_BINARY=nuclei
# NUCLEI_TEMPLATES=/path/to/nuclei-templates
# NUCLEI_SEVERITY=critical,high
# NUCLEI_TIMEOUT=5m

# --- Отладочные переключатели (1 = выключить) ---
# STARE_DISABLE_FEEDS=0
# STARE_DISABLE_ENRICH=0
# STARE_DISABLE_INTEL=0

# --- Базы и кэш (задаются в docker-compose, локально — экспортом) ---
# DB_HOST=localhost
# DB_USER=stare
# DB_PASSWORD=starepass
# DB_NAME=staredb
# REDIS_HOST=localhost
