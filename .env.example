# STARE — ключи внешних источников.
# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Незаполненный ключ = источник просто не регистрируется (скан не падает).

# --- Обязательные для P1-1 ---
# abuse.ch Auth-Key (бесплатно): https://auth.abuse.ch/
# Нужен для URLhaus и ThreatFox; Feodo Tracker работает без ключа.
ABUSECH_AUTH_KEY=

# Shodan (free): https://account.shodan.io/  → раздел "API Key"
SHODAN_API_KEY=

# GreyNoise Community: https://viz.greynoise.io/account/  → "API Key"
# Ключ опционален: без него Community API тоже отвечает (строже лимит).
GREYNOISE_API_KEY=

# AbuseIPDB (free 1000/day): https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# --- Обогащение (P0-2) ---
# IPinfo (free 50k/mo, токен опционален): https://ipinfo.io/account/token
IPINFO_TOKEN=

# --- Отладочные переключатели (1 = выключить) ---
# STARE_DISABLE_FEEDS=0
# STARE_DISABLE_ENRICH=0
# STARE_DISABLE_INTEL=0

# --- Базы и кэш (задаются в docker-compose, локально — экспортом) ---
# DB_HOST=localhost
# DB_USER=stare
# DB_PASSWORD=starepass
# DB_NAME=staredb
# REDIS_HOST=localhost
